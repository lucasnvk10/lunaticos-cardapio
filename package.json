{
  "name": "sistema-eventos",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:full": "npm run build && wrangler dev --local",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:seed:local": "wrangler d1 execute DB --local --file=./db/seed.sql",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@zxing/browser": "^0.1.5",
    "hono": "^4.9.9",
    "qrcode": "^1.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260921.1",
    "@types/node": "^24.5.2",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^5.0.3",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vitest": "^3.2.4",
    "wrangler": "^4.137.0"
  },
  "engines": {
    "node": ">=22"
  }
}
